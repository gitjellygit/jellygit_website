# Copy to .env and fill in. server.py reads these from the environment.
# For systemd: use EnvironmentFile=/path/to/.env, or export in your shell profile.

PORT=8000

# Hostinger SMTP (webmail mailbox credentials, not hPanel login)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@jellygit.com
SMTP_PASS=your-mailbox-password

# Where contact-form submissions are delivered
MAIL_TO=contact@jellygit.com
MAIL_FROM=you@jellygit.com
